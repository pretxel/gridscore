# Supabase (local defaults from `supabase start`; replace with your project's values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin (used for absolute URLs, auth redirects, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the Vercel cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=

# Race data provider. Defaults to the public Jolpica endpoint when unset.
# JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1

# ---------------------------------------------------------------------------
# Supabase CLI (`supabase start`, `supabase config push`) — copy to `.env`
# ---------------------------------------------------------------------------
# Next.js reads .env.local; the Supabase CLI reads .env. Both are gitignored.
# config.toml resolves these, so the same file drives local development and the
# linked project: `supabase start` picks up the localhost values below, and a
# deploy pushes the production ones (see docs/operator-guide.md).
SUPABASE_AUTH_SITE_URL=http://localhost:3000
SUPABASE_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
SUPABASE_AUTH_PREVIEW_CALLBACK_URL=http://127.0.0.1:3000/auth/callback
# Seconds between magic links to one address. 1s locally; 60s in production.
SUPABASE_AUTH_EMAIL_MAX_FREQUENCY=1s
